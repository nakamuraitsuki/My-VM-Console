config:
  network.ovn.northbound_connection: unix:/run/ovn/ovnnb_db.sock
storage_pools:
- name: default
  driver: zfs
  config:
    size: {{ incus_storage_size | default('20GiB') }}

networks:
- name: incusbr0
  type: bridge
  config:
    ipv4.address: {{ incus_bridge_host_ip }}
    ipv4.nat: "true"
    ipv6.address: none

profiles:
- name: default
  devices:
    root:
      path: /
      pool: default
      type: disk
    eth0:
      name: eth0
      network: incusbr0
      type: nic
